-echo "  其它会话的痕迹（/tmp 下最近 1 小时被别人建的实验目录）:"
-find /tmp -maxdepth 1 -type d -newermt '-60 min' 2>/dev/null \
-  | grep -vE '^/tmp$|/tmp/rosops|/tmp/Codex|/tmp/\.' | sed 's/^/     /'
-EOF
-chmod +x /tmp/rosops/whose_stack.sh
