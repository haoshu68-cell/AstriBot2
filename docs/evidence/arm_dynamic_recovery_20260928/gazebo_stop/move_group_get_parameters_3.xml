  <group_state name="home" group="arm_right">
    <joint name="astribot_arm_right_joint_1" value="0" />
    <joint name="astribot_arm_right_joint_2" value="0" />
    <joint name="astribot_arm_right_joint_3" value="0" />
    <joint name="astribot_arm_right_joint_4" value="0" />
    <joint name="astribot_arm_right_joint_5" value="0" />
    <joint name="astribot_arm_right_joint_6" value="0" />
    <joint name="astribot_arm_right_joint_7" value="0" />
  </group_state>

  
  <group_state name="ready" group="arm_left">
    <joint name="astribot_arm_left_joint_1" value="0" />
    <joint name="astribot_arm_left_joint_2" value="-0.5" />
    <joint name="astribot_arm_left_joint_3" value="-0.6" />
    <joint name="astribot_arm_left_joint_4" value="1.0" />
    <joint name="astribot_arm_left_joint_5" value="0" />
    <joint name="astribot_arm_left_joint_6" value="0" />
    <joint name="astribot_arm_left_joint_7" value="0" />
  </group_state>

  <group_state name="ready" group="arm_right">
    <joint name="astribot_arm_right_joint_1" value="0" />
    <joint name="astribot_arm_right_joint_2" value="-0.5" />
    <joint name="astribot_arm_right_joint_3" value="0.6" />
    <joint name="astribot_arm_right_joint_4" value="1.0" />
    <joint name="astribot_arm_right_joint_5" value="0" />
    <joint name="astribot_arm_right_joint_6" value="0" />
    <joint name="astribot_arm_right_joint_7" value="0" />
  </group_state>

  <group_state name="home" group="torso">
    <joint name="astribot_torso_joint_1" value="0.2" />
    <joint name="astribot_torso_joint_2" value="-0.4" />
    <joint name="astribot_torso_joint_3" value="0.2" />
    <joint name="astribot_torso_joint_4" value="0" />
  </group_state>

  
  <virtual_joint name="virtual_base" type="fixed" parent_frame="world" child_link="astribot_torso_base" />

  
