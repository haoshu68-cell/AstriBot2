<robot name="astribot_s1">

  

  
  <group name="arm_left">
    <chain base_link="astribot_arm_left_base_link" tip_link="astribot_arm_left_tcp_link" />
  </group>

  <group name="arm_right">
    <chain base_link="astribot_arm_right_base_link" tip_link="astribot_arm_right_tcp_link" />
  </group>

  
  <group name="dual_arm">
    <group name="arm_left" />
    <group name="arm_right" />
  </group>

  
  <group name="torso">
    <chain base_link="astribot_torso_base" tip_link="astribot_torso_end_effector" />
  </group>

  <group name="head">
    <chain base_link="astribot_head_base_link" tip_link="astribot_head_link_2" />
  </group>

  
  <group name="dual_arm_with_torso">
    <group name="torso" />
    <group name="arm_left" />
    <group name="arm_right" />
  </group>

  
  <group name="gripper_left">
    <joint name="astribot_gripper_left_joint_L1" />
  </group>

  <group name="gripper_right">
    <joint name="astribot_gripper_right_joint_L1" />
  </group>

  
  <end_effector name="eef_left" group="gripper_left" parent_group="arm_left" parent_link="astribot_arm_left_tool_link" />
  <end_effector name="eef_right" group="gripper_right" parent_group="arm_right" parent_link="astribot_arm_right_tool_link" />

  
  <group_state name="open" group="gripper_left">
    <joint name="astribot_gripper_left_joint_L1" value="0.0" />
  </group_state>
  <group_state name="closed" group="gripper_left">
    <joint name="astribot_gripper_left_joint_L1" value="0.93" />
  </group_state>
  <group_state name="open" group="gripper_right">
    <joint name="astribot_gripper_right_joint_L1" value="0.0" />
  </group_state>
  <group_state name="closed" group="gripper_right">
    <joint name="astribot_gripper_right_joint_L1" value="0.93" />
  </group_state>

  
  <group_state name="home" group="arm_left">
    <joint name="astribot_arm_left_joint_1" value="0" />
    <joint name="astribot_arm_left_joint_2" value="0" />
    <joint name="astribot_arm_left_joint_3" value="0" />
    <joint name="astribot_arm_left_joint_4" value="0" />
    <joint name="astribot_arm_left_joint_5" value="0" />
    <joint name="astribot_arm_left_joint_6" value="0" />
    <joint name="astribot_arm_left_joint_7" value="0" />
