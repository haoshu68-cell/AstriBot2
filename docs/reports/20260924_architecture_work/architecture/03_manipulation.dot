digraph architecture {
graph [bgcolor="#181818",rankdir=TB,pad="0.45",nodesep="0.5",ranksep="0.62",splines=true,fontname="Noto Sans CJK SC",fontcolor="#eeeeee",fontsize=25,labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#333333",color="#555555",penwidth=1.3,fontname="Noto Sans CJK SC",fontcolor="#f3f3f3",fontsize=18,margin="0.22,0.15"];
edge [color="#bfc2c5",penwidth=1.35,arrowsize=0.8,fontname="Noto Sans CJK SC",fontcolor="#aaaaaa",fontsize=12];

label="相机感知、机械臂规划与搬运链
 ";
image [label="RGB / Depth / CameraInfo
采集时刻 TF / 标定版本"];
mask [label="检测 / 实例分割 / ROI
当前来源按场景配置"];
cad [label="注册 CAD / 模型版本
物体坐标与尺度"];
{rank=same;mask;image;cad;}
sync [label="C++ 同步与对齐快照
原始健康 / 投影健康 / 时效"];
image -> sync; mask -> sync;
fixture [label="普通演示目标定位
场景颜色 / 几何观测"];
grasp [label="GraspNet C++ 服务
抓取候选"];
pose [label="现有已知 CAD 6D 服务
物体位姿候选"];
fp [label="FoundationPose C++ 后端
依赖准备；推理 / tracking 待验收",style="rounded,filled,dashed",color="#d5af69",fontcolor="#efd49e",fillcolor="#342f27"];
sync -> fixture; sync -> grasp; sync -> pose; cad -> pose;
sync -> fp [style=dashed,color="#d5af69"];cad -> fp [style=dashed,color="#d5af69"];
quality [label="几何一致性 / 时效 / 版本检查
物体观测与场景身份"];
pose -> quality;fp -> quality [style=dashed,color="#d5af69"];
scene [label="PlanningScene 适配与读回
障碍物 / 附着物 / 场景版本"];
template [label="物体坐标系抓取模板
待贯通 / 验收",style="rounded,filled,dashed",color="#d5af69",fontcolor="#efd49e",fillcolor="#342f27"];
quality -> scene [style=dashed,color="#d5af69",label="正式模型链待贯通"];
quality -> template [style=dashed,color="#d5af69"];
fixture -> scene;
mtc [label="MTC / IK / 整机碰撞验证
完整分阶段规划 / 剩余轨迹复核"];
scene -> mtc;
grasp -> mtc [style=dashed,color="#d5af69",label="模型候选到实际执行待验收"];
template -> mtc [style=dashed,color="#d5af69"];
exec [label="任务拥有的操作执行器
执行守卫 / Hold / 取消终态"];
mtc -> exec;
ledger [label="抓取 / 释放观察与账本确认
附着状态 / 质量 / 单调版本"];
exec -> ledger;
env [label="运输姿态 / 实测整机包络
消费者同版本 ACK / 导航准入"];
ledger -> env;
nav [label="既有导航仲裁与执行保护链
到站保持 → 放置规划与执行"];
env -> nav;
result [label="独立放置确认 / 退臂 / 空载保持
任务结果与资源释放"];
nav -> result;
note [label="灰色实线：已有实现或普通演示接线，不代表全链验收
金色虚线：候选接线 / 待贯通或待验收；FoundationPose 不等于现有 6D 服务
普通演示采用运动学附着；正式原生全阶段执行及真实接触抓取仍待验收",shape=plain,fillcolor="#181818",fontsize=14,fontcolor="#d8bc87"];
result -> note [style=invis];

}