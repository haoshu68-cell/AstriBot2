digraph architecture {
graph [bgcolor="#181818",rankdir=TB,pad="0.45",nodesep="0.5",ranksep="0.62",splines=true,fontname="Noto Sans CJK SC",fontcolor="#eeeeee",fontsize=25,labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#333333",color="#555555",penwidth=1.3,fontname="Noto Sans CJK SC",fontcolor="#f3f3f3",fontsize=18,margin="0.22,0.15"];
edge [color="#bfc2c5",penwidth=1.35,arrowsize=0.8,fontname="Noto Sans CJK SC",fontcolor="#aaaaaa",fontsize=12];

label="整机软件架构总览
 ";
operator [label="操作台 / 人工目标
路线 / 探索 / 搬运请求"];
sensors [label="激光 / IMU / 关节反馈
六相机 RGB / Depth / CameraInfo"];
calib [label="URDF / TF / 相机标定
地图与场景配置"];
{rank=same; sensors; operator; calib;}
perception [label="感知与定位
Voxel-SLAM / 自滤 / RGB-D"];
navarb [label="导航任务仲裁
TaskArbiter · 导航 Action 所有权"];
transport [label="搬运任务与资源协调
阶段 / 租约 / 取消 / 恢复"];
operator -> navarb; operator -> transport;
sensors -> perception; calib -> perception;
world [label="地图 / 障碍 / 区域
时效 / 坐标 / 健康"];
scene [label="物体观测 / PlanningScene
对象身份与场景版本"];
perception -> world; perception -> scene;
nav [label="Nav2 / BT / 路由策略
路径规划与提交"];
mtc [label="MoveIt / MTC
IK / 分阶段规划 / 碰撞校验"];
navarb -> nav; world -> nav; scene -> mtc; transport -> mtc;
{rank=same;nav;mtc;}
track [label="路径跟踪 / 到位停稳
速度平滑 / 双臂耦合"];
armexec [label="机械臂任务执行与保持
执行守卫 / 终态确认"];
nav -> track; mtc -> armexec [label="经任务拥有的执行器"];
{rank=same;track;armexec;}
envelope [label="附着物 / 质量账本
整机几何 / 固定包络 / 同版本 ACK"];
armexec -> envelope; envelope -> nav [label="运输准入与约束",constraint=false];
transport -> navarb [label="导航请求",constraint=false];
protect [label="底盘末级执行保护
FinalProtection（按 profile 启用）"];
track -> protect; envelope -> protect;
base [label="底盘执行适配
Gazebo effort / 厂家 SDK"];
arm [label="机械臂 / 夹爪执行适配
MoveIt 执行 / JTC / SDK 桥接"];
protect -> base; armexec -> arm;
{rank=same;base;arm;}
infra [label="共同基础：统一日志 / bag / 事件与参数 / 会话隔离 / 安装版本与部署",fillcolor="#242424",fontsize=16];
base -> infra [style=invis]; arm -> infra [style=invis];
note [label="已有模块关系 ≠ 全部同时上线；搬运资源协调未强制覆盖所有旧客户端
普通搬运已有完整演示，正式 C++ / fixed_v2 全链仍待验收；真机另行验收",shape=plain,fillcolor="#181818",fontsize=14,fontcolor="#d8bc87"];
infra -> note [style=invis];

}