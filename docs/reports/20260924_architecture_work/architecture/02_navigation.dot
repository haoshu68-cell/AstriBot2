digraph architecture {
graph [bgcolor="#181818",rankdir=TB,pad="0.45",nodesep="0.5",ranksep="0.62",splines=true,fontname="Noto Sans CJK SC",fontcolor="#eeeeee",fontsize=25,labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#333333",color="#555555",penwidth=1.3,fontname="Noto Sans CJK SC",fontcolor="#f3f3f3",fontsize=18,margin="0.22,0.15"];
edge [color="#bfc2c5",penwidth=1.35,arrowsize=0.8,fontname="Noto Sans CJK SC",fontcolor="#aaaaaa",fontsize=12];

label="导航、避障与底盘执行链
 ";
lidar [label="激光点云 / IMU
关节与里程计"];
rgbd [label="头部 / 腹部 RGB-D
原始健康 + 投影健康"];
request [label="人工目标 / 路线 / 探索
搬运任务导航请求"];
{rank=same;lidar;rgbd;request;}
slam [label="Voxel-SLAM
定位 / map→odom"];
filter [label="点云自滤 / 切片扫描
深度障碍投影"];
arb [label="TaskArbiter
优先级 / 取消交接 / 唯一目标"];
lidar -> slam; lidar -> filter;rgbd -> filter; request -> arb;
map [label="地图 / 区域 / 禁行约束
全局与局部 costmap"];
geometry [label="实测关节 + 附着物账本
整机几何 / 固定包络"];
confirm [label="停稳与 ArmHold
包络消费者同版本确认"];
slam -> map; filter -> map; geometry -> confirm;
{rank=same;map;confirm;}
planner [label="Nav2 BT / 路由策略
规划 / 候选复核 / 路径提交"];
arb -> planner; map -> planner;confirm -> planner [label="准入与足迹约束"];
tracker [label="Arrival / ThreePhase
路径跟踪 / 终点精调 / 停稳确认"];
planner -> tracker;
smooth [label="速度平滑 / 坐标转换
双臂姿态与运动约束"];
tracker -> smooth;
final [label="FinalProtection
输入时效 / 扫掠 / 包络 / 区域 / 许可"];
smooth -> final [label="策略启用"];
confirm -> final [constraint=false];
base [label="底盘执行适配
仿真 effort 或真机 SDK"];
final -> base;
smooth -> base [label="策略 off 的既有接线",color="#909090",constraint=false];
feedback [label="实际位姿 / 速度 / 执行状态
反馈至定位、跟踪与任务结果"];
base -> feedback;
note [label="控制出口按启动 profile 核对；感知和候选规划不直接发布底盘命令
固定包络限定场景已有验证，非 home / 偏载 / 狭窄通道完整矩阵仍待验收",shape=plain,fillcolor="#181818",fontsize=14,fontcolor="#d8bc87"];
feedback -> note [style=invis];

}