+// Copyright 2026 Astribot. SPDX-License-Identifier: Apache-2.0
+#ifndef ASTRIBOT_RENDERING_WORKER_COUNT_HH
+#define ASTRIBOT_RENDERING_WORKER_COUNT_HH
+#include <algorithm>
+#include <cstddef>
+#include <stdexcept>
+namespace astribot_rendering {
+// Unset preserves upstream behavior. An explicit count is strict and bounded.
+inline std::size_t workerCount(const char* value, std::size_t detected) {
+  if (!value) return std::max<std::size_t>(1, detected);
+  std::size_t count=0;
+  for (const char* p=value; *p; ++p) {
+    if (*p<'0' || *p>'9' || count>64)
+      throw std::invalid_argument("ASTRIBOT_OGRE2_WORKER_THREADS must be 1..64");
+    count=count*10+static_cast<std::size_t>(*p-'0');
+  }
+  if (count<1 || count>64)
+    throw std::invalid_argument("ASTRIBOT_OGRE2_WORKER_THREADS must be 1..64");
+  return count;
+}
+}
+#endif
