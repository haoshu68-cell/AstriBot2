<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>astribot_s1_perception</name>
  <version>0.1.0</version>
  <description>标准 PointCloud2/IMU 感知与统一 Voxel-SLAM 接入。</description>
  <maintainer email="dev@astribot.local">astribot-dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>python3-setuptools</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>astribot_s1_perception_native</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>astribot_s1_description</exec_depend>
  <exec_depend>astribot_s1_gazebo_bringup</exec_depend>

  <exec_depend>livox_ros_driver2</exec_depend>

  <exec_depend>astribot_logging</exec_depend>

  <exec_depend>astribot_s1_perception_components</exec_depend>
  <exec_depend>astribot_s1_slam</exec_depend>
  <exec_depend>astribot_s1_mapping</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
  <exec_depend>astribot_slam_msgs</exec_depend>
</package>
