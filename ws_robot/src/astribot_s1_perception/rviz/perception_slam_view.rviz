Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
        - /TF1
        - /PointCloud2 (left)1
        - /PointCloud2 (right)1
        - /PointCloud2 (fused)1
        - /LaserScan1
        - /Map1
    Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane Cell Count: 30
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Value: true
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
    - Alpha: 0.6
      Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: PointCloud2 (left)
      Size (m): 0.02
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Topic:
        Value: /livox/lidar_left
      Value: true
    - Alpha: 0.6
      Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: PointCloud2 (right)
      Size (m): 0.02
      Style: Points
      Color Transformer: FlatColor
      Color: 0; 170; 255
      Topic:
        Value: /livox/lidar_right
      Value: true
    - Alpha: 0.8
      Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: PointCloud2 (fused)
      Size (m): 0.02
      Style: Points
      Color Transformer: AxisColor
      Topic:
        Value: /livox/fused_points
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/LaserScan
      Color: 255; 255; 0
      Enabled: true
      Name: LaserScan
      Size (m): 0.05
      Topic:
        Value: /scan
      Value: true
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map
      Topic:
        Value: /map
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odometry (trajectory)
      Topic:
        Value: /odom
      Shape:
        Value: Arrow
      Keep: 300
      Value: true
  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Name: Current View
      Pitch: 0.9
      Target Frame: <Fixed Frame>
      Yaw: 0.8
Window Geometry:
  Height: 1000
  Width: 1600
  X: 60
  Y: 60
