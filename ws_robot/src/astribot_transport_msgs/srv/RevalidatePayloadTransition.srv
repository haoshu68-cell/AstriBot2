# Revalidation after physical ATTACH_CONFIRM / DETACH_CONFIRM. A colliding PICK
# TRANSPORT_POSTURE may be replanned against the confirmed actual payload.
# This does not authorize execution or mutate
# the global scene. The owner must independently confirm its transaction and
# full scene readback before acknowledging the transition.
string context_id
string transaction_id
uint32 start_index
moveit_msgs/PlanningScene scene
---
bool success
string reason
string context_id
string transaction_id
bool transport_replanned
# Complete suffix beginning at request.start_index. The owner must explicitly
