Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
        - /TF1
        - /Map1
        - /Global Costmap1
        - /Local Costmap1
    Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane Cell Count: 30
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Value: true
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
    - Alpha: 1
      Class: rviz_default_plugins/LaserScan
      Color: 255; 255; 0
      Enabled: true
      Name: LaserScan
      Size (m): 0.05
      Topic:
        Value: /scan
      Value: true
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map
      Topic:
        Durability Policy: Transient Local
        Value: /map
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odometry (trajectory)
      Topic:
        Value: /odom
      Shape:
        Value: Arrow
      Keep: 300
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.3
          Class: rviz_default_plugins/Map
          Color Scheme: costmap
          Enabled: true
          Name: Global Costmap
          Topic:
            Durability Policy: Transient Local
            Value: /global_costmap/costmap
          Value: true
        - Alpha: 1
          Class: rviz_default_plugins/Path
          Color: 255; 0; 0
          Enabled: true
          Name: Path (global plan)
          Topic:
            Value: /plan
          Value: true
        - Alpha: 1
          Class: rviz_default_plugins/Polygon
          Color: 25; 255; 0
          Enabled: false
          Name: Global Footprint
          Topic:
            Value: /global_costmap/published_footprint
          Value: false
      Enabled: true
      Name: Global Costmap
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.7
          Class: rviz_default_plugins/Map
          Color Scheme: costmap
          Enabled: true
          Name: Local Costmap
          Topic:
            Durability Policy: Transient Local
            Value: /local_costmap/costmap
          Value: true
        - Alpha: 1
          Class: rviz_default_plugins/Path
          Color: 0; 12; 255
          Enabled: true
          Name: Local Plan
          Topic:
            Value: /local_plan
          Value: true
        - Alpha: 1
          Class: rviz_default_plugins/Polygon
          Color: 25; 255; 0
          Enabled: true
          # 圆形足迹(robot_radius=0.35)覆盖轮子凸出部分+安全余量，不代表双臂/头部展开
          # 时的真实包络——那部分风险靠 arm_speed_limiter_node 的展开限速缓解，
          # 详见 README_NAVIGATION.md。
          Name: Local Footprint
          Topic:
            Value: /local_costmap/published_footprint
          Value: true
      Enabled: true
      Name: Local Costmap
  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Name: Current View
      Pitch: 0.9
      Target Frame: <Fixed Frame>
      Yaw: 0.8
Window Geometry:
  Height: 1000
  Width: 1600
  X: 60
  Y: 60
  Navigation 2:
    collapsed: false
