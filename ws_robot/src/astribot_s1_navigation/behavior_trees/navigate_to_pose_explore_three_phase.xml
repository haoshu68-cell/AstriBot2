<!--
  探索场景专用行为树：与 nav2 自带的
  navigate_w_recovery_and_replanning_only_if_path_becomes_invalid.xml
  **逐节点一致**，唯一差别是 FollowPath 的 controller_id 指向三段式控制器实例。
  （2026-09-08 之前它对齐的是 navigate_to_pose_w_replanning_and_recovery.xml，
    即 1Hz 无条件重规划；换基准的理由见下面 RateController 那块注释。）

  为什么用「换一份 BT」而不是「改协调器去发 FollowPath」：
    · 保留整套恢复行为（清代价地图 / Spin / Wait / BackUp）。协调器直发
      FollowPath 会把这些全丢掉，而它自己只有「失败就换下一个候选点」
      这一种恢复手段。
    · 只需在 NavigateToPose 目标里填 behavior_tree 字段，改动面极小。

  controller_id 指向 FollowPathExplore —— 该实例 align_goal_enabled=false，
  即「到位后不再原地转朝向」，与 exploration_coordinator_params.yaml 的
  check_yaw: false 是同一个决定的两半，必须同时改。

  需要终点对齐的场景（如搬运）用默认实例 FollowPath（2026-09-07 起它就是三段式，
  align_goal_enabled=true），不要改这份文件 —— 另起一份，
  避免两个场景共用一份而互相牵制。
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <!-- ═══ 2026-09-08：去掉周期重规划，改成「路径失效时才重规划」═══
             原来这里是裸的 RateController hz="1.0" 包 ComputePathToPose，
             即**每秒无条件重算一条全局路径**。实测代价：36 个目标换了 393 条
             路径、每条只活 1.5s —— 没有任何一条路径被真正跟踪到位，而三段式
             控制器的 ALIGN_START 预算是按「一次 setPlan = 一次新尝试」发的。

             现在的结构逐节点照抄 nav2 自带的
             navigate_w_recovery_and_replanning_only_if_path_becomes_invalid.xml，
             只把 controller_id 换成 FollowPathExplore：
               · RateController 仍以 1Hz tick，但正常情况下走的是 IsPathValid
                 这个**便宜的校验**，不再调 planner；
               · 只有「目标换了」或「路径真被障碍挡住」才落到 ComputePathToPose。

             注意 IsPathValid 走 planner_server 的 is_path_valid 服务，
             用的是**全局** costmap。建图过程中地图在长，所以重规划次数不会是
             严格的 1 次；要的是「不会一路撞上去」，不是「一次都不重算」。

             GlobalUpdatedGoal / IsPathValid / RateController 三个节点都在
             bt_navigator 的**默认** plugin_lib_names 里（本仓库 yaml 没有覆盖
             plugin_lib_names，已在 libbt_navigator_core.so 里逐个确认存在），
             所以不需要动 nav2_params_*.yaml。

             一键回退：把下面的 Fallback 整块删掉，只留 ComputePathToPose。 -->
        <RateController hz="1.0" name="RateControllerComputePathToPose">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <Fallback name="FallbackComputePathToPose">
              <ReactiveSequence name="CheckIfNewPathNeeded">
                <Inverter>
                  <GlobalUpdatedGoal/>
                </Inverter>
                <IsPathValid path="{path}"/>
              </ReactiveSequence>
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            </Fallback>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <!-- 与默认 BT 的唯一差别就是下面这个 controller_id -->
          <FollowPath path="{path}" controller_id="FollowPathExplore"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Spin spin_dist="1.57"/>
          <Wait wait_duration="5"/>
          <BackUp backup_dist="0.30" backup_speed="0.05"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
