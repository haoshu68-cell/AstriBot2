<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>astribot_s1_navigation</name>
  <version>0.1.0</version>
  <description>
    Astribot S1 Nav2 自主导航集成：复用 astribot_s1_perception 已验证的双 Livox 感知 +
    SLAM Toolbox 建图/定位栈，新增 controller_server/planner_server/behavior_server/
    bt_navigator/velocity_smoother 等 Nav2 节点，以及两个自研适配节点——车体系→world系
    cmd_vel 转换（配合本机 gz-sim VelocityControl 插件的 world 系语义）、机械臂展开限速。
    不运行 nav2_map_server/amcl，全局代价地图直接订阅 SLAM Toolbox 发布的 /map。
  </description>
  <maintainer email="dev@astribot.local">astribot-dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>python3-setuptools</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- Nav2 完整栈：本机已通过 ros-humble-navigation2/ros-humble-nav2-bringup 装好，
       这里声明依赖名方便 rosdep/文档追踪，不需要重新安装 -->
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>astribot_s1_perception</exec_depend>
  <exec_depend>astribot_s1_autonomy</exec_depend>
  <exec_depend>astribot_s1_dynamics_coupling</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
