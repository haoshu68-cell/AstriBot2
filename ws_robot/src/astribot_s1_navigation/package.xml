<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>astribot_s1_navigation</name>
  <version>0.1.0</version>
  <description>Nav2 集成：感知与地图接入、事件触发规划、任务仲裁、路径跟踪、速度链路和运行诊断。支持仿真与真机配置。</description>
  <maintainer email="dev@astribot.local">astribot-dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>python3-setuptools</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>astribot_s1_path_tracking</exec_depend>
  <exec_depend>astribot_s1_perception</exec_depend>
  <exec_depend>astribot_s1_dynamics_coupling</exec_depend>

  <exec_depend>astribot_logging</exec_depend>

  <exec_depend>astribot_s1_perception_components</exec_depend>
  <exec_depend>astribot_s1_exploration</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
  <exec_depend>astribot_s1_navigation_policy</exec_depend>
  <exec_depend>astribot_route_executor</exec_depend>
  <exec_depend>astribot_operator_backend</exec_depend>
  <exec_depend>astribot_map_manager</exec_depend>
  <exec_depend>astribot_s1_robot_geometry</exec_depend>
</package>
