get_filename_component(_astribot_eigen_root "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(EIGEN3_VERSION_STRING "3.4.0")
set(EIGEN3_VERSION_MAJOR 3)
set(EIGEN3_VERSION_MINOR 4)
set(EIGEN3_VERSION_PATCH 0)
set(EIGEN3_FOUND TRUE)
set(Eigen3_FOUND TRUE)
set(EIGEN3_INCLUDE_DIR "${_astribot_eigen_root}/include/eigen3")
if(NOT EXISTS "${EIGEN3_INCLUDE_DIR}/Eigen/Core")
  message(FATAL_ERROR "Repository Eigen headers missing: ${EIGEN3_INCLUDE_DIR}")
endif()
set(EIGEN3_INCLUDE_DIRS "${EIGEN3_INCLUDE_DIR}")
set(EIGEN3_DEFINITIONS "")
set(EIGEN3_ROOT_DIR "${_astribot_eigen_root}")
if(NOT TARGET Eigen3::Eigen)
  add_library(Eigen3::Eigen INTERFACE IMPORTED)
  set_target_properties(Eigen3::Eigen PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${EIGEN3_INCLUDE_DIR}")
endif()
