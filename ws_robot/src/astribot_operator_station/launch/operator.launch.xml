<launch>
  <arg name="recorder" default="false" description="Enable only on the robot/recording host; workstation normally runs RViz only"/>
  <arg name="params_file" default="$(find-pkg-share astribot_operator_station)/config/recorder.yaml"/>
  <arg name="use_sim_time" default="false"/>
  <node if="$(var recorder)" pkg="astribot_operator_station" exec="diagnostics_recorder" output="screen">
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
  <node pkg="rviz2" exec="rviz2" args="-d $(find-pkg-share astribot_operator_station)/config/operator.rviz" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
