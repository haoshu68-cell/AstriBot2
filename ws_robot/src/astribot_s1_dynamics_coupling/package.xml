<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>astribot_s1_dynamics_coupling</name>
  <version>0.1.0</version>
  <description>
    臂-底盘动力学耦合动态调速：独立、无侵入的中间控制层节点，根据双臂展开幅度+
    关节角速度实时计算 0~1.0 连续限速系数，在"世界坐标系速度输出之后、
    gz-sim VelocityControl 插件接收之前"这个位置对 Twist 做缩放/钳位/平滑，
    解决机械臂运动诱发的重心偏移、roll/pitch 姿态漂移、整机倾倒问题。
    不修改 VelocityControl 驱动架构、坐标变换、SLAM、雷达滤波、TF、Nav2核心逻辑、
    既有安全监控与静态臂限速逻辑，只通过 launch 参数覆盖把现有节点的输出话题
    重定向到中间话题，本包节点桥接到真正的 /cmd_vel。
  </description>
  <maintainer email="dev@astribot.local">astribot-dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>python3-setuptools</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <!-- C1 修正后展开度量改成查 TF 求水平伸展，需要 tf2_ros 的 Buffer/TransformListener -->
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
