<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>astribot_trajectory_bridge</name>
  <version>0.1.0</version>
  <description>厂商 SDK 与 ROS2 的状态、里程计、轨迹 action 和底盘命令桥接；统一关节命名与单位转换，执行通路由配置及运行保护约束。</description>
  <maintainer email="dev@astribot.local">astribot-dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>python3-setuptools</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>astribot_msgs</exec_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>astribot_bridge_msgs</exec_depend>
  <exec_depend>astribot_trajectory_bridge_native</exec_depend>

  <exec_depend>astribot_logging</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
