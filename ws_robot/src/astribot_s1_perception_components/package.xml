<?xml version="1.0"?>
<package format="3">
  <name>astribot_s1_perception_components</name>
  <version>0.2.0</version>
  <description>Perception ROS adapters; no navigation authority.</description>
  <maintainer email="dev@astribot.local">Astribot Robotics</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>astribot_autonomy_core</depend>
  <depend>pcl_conversions</depend>
  <depend>libpcl-all-dev</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>astribot_logging</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
