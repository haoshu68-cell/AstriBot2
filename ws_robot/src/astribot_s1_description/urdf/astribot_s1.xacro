<?xml version="1.0"?>
<!--
  文件用途：Astribot S1 轮式双臂机器人 —— 顶层 xacro 入口。
  聚合：底盘(4麦克纳姆轮+4自由度升降躯干) + 头部(2自由度) + 左右机械臂(各7自由度)
       + 可选传感器(双 Livox Mid-360 3D激光雷达/RGB相机) + ros2_control + Gazebo 插件。

  用法（供 launch.py 调用，见 astribot_s1_gazebo_bringup/launch/warehouse_sim.launch.py）：
    xacro astribot_s1.xacro robot_name:=astribot_s1 use_lidar:=true use_camera:=true \
          controllers_config:=<colcon安装后由 FindPackageShare 算出的绝对路径>
-->
<robot name="$(arg robot_name)" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============ 可调参数（全部通过 launch 参数外部传入，禁止在此写死） ============ -->
  <!-- robot_name：同时用作 <robot name="">、Gazebo 生成实体名(-name)、传感器 gz 话题前缀，
       三处必须一致，才能保证 ros_gz_bridge 桥接到正确的 gz 话题；用于避免多机器人重名冲突。 -->
  <xacro:arg name="robot_name" default="astribot_s1"/>
  <xacro:arg name="use_lidar" default="true"/>
  <xacro:arg name="use_camera" default="true"/>
  <!-- 双 Livox Mid-360 安装位姿：左前 + 右后对角布局（用户指定），扩大合并视场、
       减少互相遮挡的盲区（默认值，可外部覆盖）。
       xyz/rpy 用空格分隔的字符串（xacro origin 惯用写法），改这两个参数即可调整安装位置，
       不需要碰 astribot_s1_sensors.xacro 里的宏定义本身。
       坐标约定：torso_base 局部系 +x 朝前、+y 朝左（沿用现有 lidar/camera 挂载点惯例）。 -->
  <xacro:arg name="livox_left_xyz" default="0.28 0.18 0.10"/>
  <xacro:arg name="livox_left_rpy" default="0 0 0.4"/>
  <xacro:arg name="livox_right_xyz" default="-0.28 -0.18 0.10"/>
  <xacro:arg name="livox_right_rpy" default="0 0 2.74"/>
  <!-- controllers_config：ros2_control 控制器 yaml 的绝对路径字符串，
       由调用方（launch.py）用 FindPackageShare + PathJoinSubstitution 拼出后传入，
       本文件内部不出现任何硬编码路径。 -->
  <xacro:arg name="controllers_config" default=""/>

  <!-- 麦克纳姆轮力矩闭环驱动改造新增：轮子effort硬件接口边界 + 几何半径统一从这里
       外部传入，禁止在 torso_wheel/ros2_control xacro 里写死。
       wheel_radius 同时驱动碰撞体球半径(astribot_s1_torso_wheel.xacro)和
       astribot_s1_chassis_effort_drive 包里逆解运动学的同名ROS2参数——
       "改变轮子大小做多轮测试"时只需要改这一个xacro参数，但 spawn_z 要跟着按
       spawn_z=0.02+wheel_radius 这个经验公式同步调整(见
       astribot_s1_gazebo_bringup/launch/warehouse_sim.launch.py 的 spawn_z 说明)，
       否则出生时轮子和地面的穿透/悬空量不对，扫描结果没有意义。
       wheel_effort_limit/wheel_velocity_limit 是轮关节URDF<limit>标签和
       ros2_control effort command_interface的min/max边界，起始估算值，
       需要方案里的单轮测试①标定。 -->
  <xacro:arg name="wheel_radius" default="0.08"/>
  <xacro:arg name="wheel_effort_limit" default="15.0"/>
  <xacro:arg name="wheel_velocity_limit" default="40.0"/>
  <!-- 轮关节粘性阻尼(N·m·s/rad)和静摩擦(N·m)：力矩闭环稳定的必要条件，
       没有它轮子是无阻尼自由旋转体、PID会在扭矩限幅间bang-bang振荡，
       详见 astribot_s1_torso_wheel.xacro 顶部"轮关节dynamics"实测记录。 -->
  <xacro:arg name="wheel_joint_damping" default="1.0"/>
  <xacro:arg name="wheel_joint_friction" default="0.1"/>

  <xacro:property name="use_lidar_prop" value="$(arg use_lidar)"/>
  <xacro:property name="use_camera_prop" value="$(arg use_camera)"/>
  <xacro:property name="robot_name_prop" value="$(arg robot_name)"/>

  <!-- ============ 载入各功能模块 ============ -->
  <xacro:include filename="$(find astribot_s1_description)/urdf/astribot_s1_torso_wheel.xacro"/>
  <xacro:include filename="$(find astribot_s1_description)/urdf/astribot_s1_head.xacro"/>
  <xacro:include filename="$(find astribot_s1_description)/urdf/astribot_s1_arm.xacro"/>
  <xacro:include filename="$(find astribot_s1_description)/urdf/astribot_s1_sensors.xacro"/>
  <xacro:include filename="$(find astribot_s1_description)/urdf/astribot_s1_ros2_control.xacro"/>
  <xacro:include filename="$(find astribot_s1_description)/urdf/astribot_s1.gazebo.xacro"/>

  <!-- ============ 传感器（按参数开关，默认都打开） ============ -->
  <!-- 双 Livox Mid-360：分别实例化 left/right，frame_id 各自独立
       （livox_mid360_left / livox_mid360_right，不共用同一个 frame_id）。 -->
  <xacro:if value="${use_lidar_prop}">
    <xacro:astribot_s1_livox_mid360
      side="left" parent="astribot_torso_base" robot_name="${robot_name_prop}"
      xyz="$(arg livox_left_xyz)" rpy="$(arg livox_left_rpy)"/>
    <xacro:astribot_s1_livox_mid360
      side="right" parent="astribot_torso_base" robot_name="${robot_name_prop}"
      xyz="$(arg livox_right_xyz)" rpy="$(arg livox_right_rpy)"/>
  </xacro:if>
  <xacro:if value="${use_camera_prop}">
    <xacro:astribot_s1_camera parent="astribot_head_link_2" robot_name="${robot_name_prop}"/>
  </xacro:if>

  <!-- ============ ros2_control + gz_ros2_control 插件 ============ -->
  <!-- wheel_effort_limit 不再传进 astribot_s1_ros2_control 宏——实测发现
       gz_ros2_control(ros-humble-hardware-interface 2.54.0) 解析
       <command_interface name="effort"><param name="min"/><param name="max"/></command_interface>
       这种带子标签的写法时会把该关节整体跳过(initSim日志里"Loading joint"
       完全不出现)，改成最简单的<command_interface name="effort"/>后正常。
       力矩限幅改成完全交给 astribot_s1_chassis_effort_drive 包的PID闭环代码
       clamp(软件层强制限幅，真正生效的那一层)，详见
       astribot_s1_ros2_control.xacro 里的踩坑记录。 -->
  <xacro:astribot_s1_ros2_control controllers_config="$(arg controllers_config)"/>

  <!-- ============ 底盘：里程计发布 + 轮子各向异性摩擦(力矩闭环治本改造后，
       VelocityControl/MecanumDrive 已移除，车身运动完全由轮子effort力矩经
       轮地接触物理驱动，见 astribot_s1_chassis_effort_drive 包) ============ -->
  <xacro:astribot_s1_gazebo_chassis_plugins robot_name="${robot_name_prop}"/>

</robot>
