<?xml version="1.0"?>
<!--
  文件用途：底盘全向轮驱动 + 里程计发布 + 轮子摩擦系数，均为 Gazebo(Ignition/Gz Sim) 专用标签，
  对 RViz/Drake 等其它使用方无影响（<gazebo> 标签会被非 Gazebo 的 URDF 解析器忽略）。

  ============================ 版本兼容说明（务必先确认本机 Gazebo 版本再用） ============================
  ROS2 Humble 在 apt 官方源下默认搭配的是 Ignition Gazebo **Fortress**（libignition-gazebo6），
  这也是本方案实测环境（`apt-cache depends ros-humble-ros-gz-sim` 显示依赖 libignition-gazebo6-dev）。
  下面统一使用新版 "gz-*" 插件命名（ros_gz 系列包在 Fortress/Garden 上都兼容这套命名），
  如果实际运行环境是更旧的 Ignition Gazebo（命令是 `ign gazebo` 而非 `gz sim`），
  需要把下面两处 plugin 的 filename/name 换成注释里给出的 `ignition-gazebo-*`/`ignition::gazebo::systems::*` 写法。
  =====================================================================================================
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="astribot_s1_gazebo_chassis_plugins"
               params="robot_name:=astribot_s1 wheel_radius:=0.08 wheel_separation:=0.4327 wheelbase:=0.4327">

    <!-- ========== 底盘全向驱动：VelocityControl(实际驱动身体位移) + MecanumDrive(轮子视觉旋转) ==========

         !!! 实测踩坑记录（麦克纳姆轮"轮子转、车不走"bug 的完整排查过程）!!!
         第一轮尝试：给四个轮子配置各向异性摩擦（fdir1 按 45°对角线 + mu2=0，完全照抄
         gz-sim 官方示例 `/usr/share/ignition/ignition-gazebo6/worlds/mecanum_drive.sdf`
         的写法，连碰撞体形状都改成官方示例用的球体）。结果实测：
           - 直接跑官方示例：车辆确实产生了平移（验证这套摩擦方案在本机物理引擎下可行）；
           - 把官方示例的轮子等比例缩小到接近我们机器人的尺寸(半径0.3m→0.075m)后
             重新测试同一份官方示例：**平移消失了**——证明这不是我们的配置错误，
             而是 gz-sim6(Fortress)+DART 物理引擎组合下，这套"各向异性摩擦"近似方案本身
             在小尺寸轮子上会失效（大概率是接触点计算/摩擦锥在小尺寸下数值不稳定，
             不是文档记录的已知限制，是本方案实测发现的）。本机器人轮子半径只有0.08m，
             正好落在这个失效区间内，所以无论怎么调摩擦系数/坐标系表达都不会有效果。
         第二轮修复（本方案最终采用）：改用 gz-sim 官方 `VelocityControl` 系统插件
         （示例：`/usr/share/ignition/ignition-gazebo6/worlds/velocity_control.sdf`）
         ——它不依赖轮子-地面摩擦力学，而是直接对模型本体设置线速度/角速度，
         从根本上绕开了"小尺寸轮子摩擦近似失效"这个物理引擎数值问题，实测在本机器人
         真实质量(39kg躯干)和真实轮子尺寸(0.08m)下 x/y/yaw 三个自由度平移旋转都正常。
         MecanumDrive 插件保留下来，只用来让轮子按论理转速转起来做视觉效果
         （它自己单独驱动的车身位移量在我们的尺寸下可忽略不计，不会和 VelocityControl
         的真实位移打架，两者互不干扰，同时生效）。 -->
    <gazebo>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <!-- 兼容提示：ignition-gazebo-velocity-control-system /
             ignition::gazebo::systems::VelocityControl。
             没有 <topic> 子标签可配置——它固定订阅 "/model/<模型名>/cmd_vel"
             （官方示例验证过，和 ros_gz_bridge 里桥接的目标话题名天然一致，不用额外配置）。 -->
      </plugin>

      <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
        <!-- 兼容提示（旧版 Ignition Gazebo Fortress 早期/自编译环境可能仍需要这两行写法）：
             filename="ignition-gazebo-mecanum-drive-system"
             name="ignition::gazebo::systems::MecanumDrive" -->
        <front_left_joint>wheel_LF_Joint</front_left_joint>
        <front_right_joint>wheel_RF_Joint</front_right_joint>
        <back_left_joint>wheel_LR_Joint</back_left_joint>
        <back_right_joint>wheel_RR_Joint</back_right_joint>
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheelbase>${wheelbase}</wheelbase>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <!-- 与 astribot_chassis.yaml 的 joint_max_velocities: [1.0, 1.0, 2.0] (x, y, yaw) 保持一致 -->
        <max_linear_velocity>1.0</max_linear_velocity>
        <min_linear_velocity>-1.0</min_linear_velocity>
        <max_angular_velocity>2.0</max_angular_velocity>
        <min_angular_velocity>-2.0</min_angular_velocity>
        <min_acceleration>-5.0</min_acceleration>
        <max_acceleration>5.0</max_acceleration>
        <min_jerk>-50.0</min_jerk>
        <max_jerk>50.0</max_jerk>
        <!-- !!! 实测踩坑记录 !!!：MecanumDrive 的 <topic> 只要显式写了，就是"字面量"话题名，
             不会像 OdometryPublisher 的 <odom_topic> 那样自动补上 "/model/<name>/" 前缀，
             必须显式写成和 ros_gz_bridge 配置一致的绝对话题名，否则订阅不到消息。 -->
        <topic>/model/${robot_name}/cmd_vel</topic>
        <odom_topic>/model/${robot_name}/mecanum_odometry</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>astribot_torso_base</child_frame_id>
      </plugin>

      <!-- MecanumDrive/VelocityControl 都不发布可靠的 TF，单独挂 OdometryPublisher 补
           /tf 与 nav_msgs/Odometry（它是基于模型真实位姿变化算出来的，不受上面选用哪个
           驱动插件影响）。
           !!! 实测踩坑记录 !!!：一开始仿照 MecanumDrive 那样给它加了显式的
           <odom_topic>/<tf_topic> 绝对路径，结果这个插件直接不再发布任何东西了
           （<odom_topic>不是 OdometryPublisher 认识的标签名，多出来的未知子标签让这个
           plugin 加载/解析出了问题）。OdometryPublisher 自己的默认行为就是按
           "/model/<模型名>/odometry"、"/model/<模型名>/tf" 这样自动加前缀发布
           （已实测验证过默认行为正确），所以这里保持默认，不要再加那两个标签。 -->
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <!-- 兼容提示：ignition-gazebo-odometry-publisher-system /
             ignition::gazebo::systems::OdometryPublisher -->
        <odom_frame>odom</odom_frame>
        <robot_base_frame>astribot_torso_base</robot_base_frame>
        <odom_publish_frequency>50</odom_publish_frequency>
        <dimensions>3</dimensions>
      </plugin>

      <!-- !!! 实测踩坑记录（新增，非常关键）!!!：aws_robomaker_small_warehouse_world 的
           world 文件本身一个 <plugin> 标签都没有，gz-sim 找不到 world 级插件配置时，
           会退回 ~/.gz(或.ignition)/sim/<ver>/server.config 里的默认系统插件列表——
           实测那份默认列表只有 Physics/UserCommands/SceneBroadcaster 三个，
           **没有 Sensors 系统**！缺了它，机器人身上所有 camera/gpu_lidar 传感器
           （包括这里新加的双 Livox Mid-360，也包括头部相机）只会被解析、
           永远不会真正渲染/发布任何数据——话题能在 `ros2 topic list` 里看到，
           但 `ros2 topic hz` 永远拿不到消息，很容易被误判成"话题名/桥接配置错了"。
           因为不允许修改 aws 官方仓库的 world 文件，这里改成把 Sensors 系统插件挂在
           "我们自己机器人模型"的 <gazebo> 标签下——gz-sim 的 Sensors 系统一旦在
           场景里任意实体上加载成功，就会全局接管整个仿真里所有传感器的渲染，
           不需要非挂在 world 实体上不可，这是应对"不能改 world 文件"场景的标准做法。 -->
      <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
        <!-- 兼容提示：ignition-gazebo-sensors-system / ignition::gazebo::systems::Sensors -->
        <render_engine>ogre2</render_engine>
      </plugin>
    </gazebo>

    <!-- !!! 实测踩坑记录（第三轮，真正的"平移正常但会慢慢倾倒"根因）!!!：上一版本把
         四个轮子摩擦系数恢复成普通各向同性摩擦(mu1=mu2=1.0)，理由是"轮子不再负责实际
         驱动身体位移，只是给轮子一个合理的地面摩擦力，避免打滑的观感问题"——这个理由
         本身是错的。MecanumDrive 插件仍然在**独立**按照它自己内部的全向轮运动学公式
         计算并驱动四个轮子关节的转速（只是为了让轮子在视觉上转得"看起来对"），这个转速
         是按"轮子和地面之间存在真实摩擦、靠摩擦力驱动车身"这个假设算出来的；但车身实际
         的位移是由 VelocityControl 直接设定的，和轮子转速隐含的"应有位移"并不是同一回事
         （两者独立计算，几乎不可能完全一致）。只要轮子还有摩擦(mu1/mu2>0)，这个"轮子
         转速暗示的运动"和"车身实际被强制的运动"之间的差异，就会在每一步物理仿真里
         通过轮地接触点的摩擦力反馈到车身上——而 VelocityControl 只接管了车身的
         线速度/角速度(vx,vy,yaw角速度)这三个自由度，并不接管 z 高度和 roll/pitch，
         这三个"没人管"的自由度会持续吸收这部分冲突产生的力矩，日积月累就是实测看到的
         现象：机器人明明没怎么移动（长时间原地小范围巡游/自转），也没有撞到任何货架，
         z 高度和俯仰角却在几十秒到一两分钟内缓慢爬升，最终以一个不上不下、卡住不动的
         倾斜姿态"定住"。
         根治办法：既然车身位移已经完全交给 VelocityControl 负责，轮子和地面之间就
         不应该再有任何真实摩擦力参与——把 mu1/mu2 直接清零，轮子只保留碰撞形状用来
         防止穿模，不再通过摩擦对车身产生任何反作用力，MecanumDrive 算出来的轮速只用来
         让轮子在视觉上"转起来"，不变成任何实际作用力。这样两个插件才是真正互不干扰。 -->
    <gazebo reference="wheel_RF_Link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
    <gazebo reference="wheel_LF_Link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
    <gazebo reference="wheel_RR_Link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
    <gazebo reference="wheel_LR_Link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>

  </xacro:macro>

</robot>
