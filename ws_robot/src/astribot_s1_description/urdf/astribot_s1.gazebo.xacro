<?xml version="1.0"?>
<!--
  文件用途：底盘全向轮驱动 + 里程计发布 + 轮子摩擦系数，均为 Gazebo(Ignition/Gz Sim) 专用标签，
  对 RViz/Drake 等其它使用方无影响（<gazebo> 标签会被非 Gazebo 的 URDF 解析器忽略）。

  ============================ 版本兼容说明（务必先确认本机 Gazebo 版本再用） ============================
  ROS2 Humble 在 apt 官方源下默认搭配的是 Ignition Gazebo **Fortress**（libignition-gazebo6），
  这也是本方案实测环境（`apt-cache depends ros-humble-ros-gz-sim` 显示依赖 libignition-gazebo6-dev）。
  下面统一使用新版 "gz-*" 插件命名（ros_gz 系列包在 Fortress/Garden 上都兼容这套命名），
  如果实际运行环境是更旧的 Ignition Gazebo（命令是 `ign gazebo` 而非 `gz sim`），
  需要把下面两处 plugin 的 filename/name 换成注释里给出的 `ignition-gazebo-*`/`ignition::gazebo::systems::*` 写法。
  =====================================================================================================
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="astribot_s1_gazebo_chassis_plugins" params="robot_name:=astribot_s1">

    <!-- ========== 底盘驱动架构演进史（麦克纳姆轮"轮子转、车不走"→"两套独立运动学
         打架诱发倾倒"→"治本：力矩闭环"的完整排查过程，务必先读完再改这个文件）==========

         !!! 实测踩坑记录 !!!
         第一轮尝试：给四个轮子配置各向异性摩擦（fdir1 按 45°对角线 + mu2=0，完全照抄
         gz-sim 官方示例 `/usr/share/ignition/ignition-gazebo6/worlds/mecanum_drive.sdf`
         的写法，连碰撞体形状都改成官方示例用的球体）。结果实测：
           - 直接跑官方示例：车辆确实产生了平移（验证这套摩擦方案在本机物理引擎下可行）；
           - 把官方示例的轮子等比例缩小到接近我们机器人的尺寸(半径0.3m→0.075m)后
             重新测试同一份官方示例：**平移消失了**——证明这不是我们的配置错误，
             而是 gz-sim6(Fortress)+DART 物理引擎组合下，这套"各向异性摩擦"近似方案本身
             在小尺寸轮子上会失效（大概率是接触点计算/摩擦锥在小尺寸下数值不稳定，
             不是文档记录的已知限制，是本方案实测发现的）。本机器人轮子半径只有0.08m，
             正好落在这个失效区间内，所以无论怎么调摩擦系数/坐标系表达都不会有效果。
         第二轮修复：改用 gz-sim 官方 `VelocityControl` 系统插件直接对模型本体设置
         线速度/角速度，绕开"小尺寸轮子摩擦近似失效"问题，配合 `MecanumDrive` 插件
         单独驱动四个轮子关节做视觉转动——这是很长一段时间的"最终采用"方案。
         第三轮踩坑（真正的"平移正常但会慢慢倾倒"根因）：MecanumDrive 独立按运动学
         公式算轮速、VelocityControl 独立设定车身速度，两者互不知情；只要轮子还有
         摩擦(mu1/mu2>0)，两套独立计算的残差就会通过轮地接触点反馈到车身，而
         VelocityControl 不接管 z/roll/pitch，这三个自由度持续吸收残差力矩，
         日积月累导致"没撞任何东西也会缓慢倾倒"。根治：把 mu1/mu2 直接清零。
         第四轮尝试（已实测验证不可行，已回退）：想在清零摩擦的基础上重新引入一组
         大幅收紧的各向异性摩擦，做"可量化误差力矩风险"和"真实轮地约束"之间的折中。
         4组测试（纯旋转零漂移 vs 纯平移必然复现倾倒，且跟mu大小无关只跟时长/路程
         相关）证实：只要 MecanumDrive+VelocityControl 两套独立运动学并行的架构不变，
         mu>0 就必然有风险，不是参数问题，是结构问题——真正的根治方案只能是把两套
         独立运动学合并成一条经过真实轮地接触物理的力矩闭环链路。

         !!! 第五轮（治本改造，本次落地）!!!：按"麦轮力控重构方案"实施——
           - VelocityControl、MecanumDrive 两个插件**整体移除**（见下方，不再声明）；
           - 车身运动完全由轮子 effort 力矩经真实轮地接触摩擦驱动，力矩由新增的
             astribot_s1_chassis_effort_drive 包（mecanum_effort_drive_node：
             麦克纳姆逆解 + 轮速PID + 摩擦前馈）计算，经 ros2_control 的
             effort command_interface 下发（见 astribot_s1_ros2_control.xacro）；
           - 车轮不再需要"视觉转动"这个概念——转速是真实力矩驱动出来的物理结果，
             跟车身位移天然一致，不存在"两套独立运动学"这个问题了；
           - 各向异性摩擦（fdir1对角线方案，第一轮已验证的坐标系表达）重新启用，
             但语义变了：mu 不再是"尽量清零避免冲突残差"，是**真实驱动摩擦力**，
             第一轮"小轮子在DART下数值不稳定"这个历史踩坑依然可能复现——如果这次
             实测又出现"轮转车不动"，先跑接触求解器调参清单，再考虑TPE物理引擎，
             不要立刻怀疑逆解代码，两种故障现象不同（符号错了是"转向不对/原地
             打转"，摩擦失效是"轮子转但完全没有对应位移"）。 -->
    <gazebo>
      <!-- MecanumDrive/VelocityControl 都不发布可靠的 TF，单独挂 OdometryPublisher 补
           /tf 与 nav_msgs/Odometry（它是基于模型真实位姿变化算出来的，跟底盘是运动学
           直控还是力矩闭环驱动完全无关，两套架构切换都不用碰这个插件）。
           !!! 实测踩坑记录 !!!：一开始仿照 MecanumDrive 那样给它加了显式的
           <odom_topic>/<tf_topic> 绝对路径，结果这个插件直接不再发布任何东西了
           （<odom_topic>不是 OdometryPublisher 认识的标签名，多出来的未知子标签让这个
           plugin 加载/解析出了问题）。OdometryPublisher 自己的默认行为就是按
           "/model/<模型名>/odometry"、"/model/<模型名>/tf" 这样自动加前缀发布
           （已实测验证过默认行为正确），所以这里保持默认，不要再加那两个标签。 -->
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <!-- 兼容提示：ignition-gazebo-odometry-publisher-system /
             ignition::gazebo::systems::OdometryPublisher -->
        <odom_frame>odom</odom_frame>
        <robot_base_frame>astribot_torso_base</robot_base_frame>
        <odom_publish_frequency>50</odom_publish_frequency>
        <dimensions>3</dimensions>
      </plugin>

      <!-- !!! 实测踩坑记录（非常关键）!!!：aws_robomaker_small_warehouse_world 的
           world 文件本身一个 <plugin> 标签都没有，gz-sim 找不到 world 级插件配置时，
           会退回 ~/.gz(或.ignition)/sim/<ver>/server.config 里的默认系统插件列表——
           实测那份默认列表只有 Physics/UserCommands/SceneBroadcaster 三个，
           **没有 Sensors 系统**！缺了它，机器人身上所有 camera/gpu_lidar 传感器
           （包括双 Livox Mid-360，也包括头部相机）只会被解析、永远不会真正渲染/
           发布任何数据——话题能在 `ros2 topic list` 里看到，但 `ros2 topic hz`
           永远拿不到消息，很容易被误判成"话题名/桥接配置错了"。
           因为不允许修改 aws 官方仓库的 world 文件，这里改成把 Sensors 系统插件挂在
           "我们自己机器人模型"的 <gazebo> 标签下——gz-sim 的 Sensors 系统一旦在
           场景里任意实体上加载成功，就会全局接管整个仿真里所有传感器的渲染，
           不需要非挂在 world 实体上不可，这是应对"不能改 world 文件"场景的标准做法。 -->
      <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
        <!-- 兼容提示：ignition-gazebo-sensors-system / ignition::gazebo::systems::Sensors -->
        <render_engine>ogre2</render_engine>
      </plugin>
    </gazebo>

    <!-- !!! 各向异性摩擦：真实驱动力，不是第四轮的"误差力矩折中"（第五轮/治本改造） !!!
         力矩闭环架构下，摩擦力是轮子唯一的驱动力来源，mu 从第四轮的收紧值(0.05)
         改回接近真实橡胶轮-混凝土地面实测范围(0.6~0.8)，比第一轮用过的1.0略低作为
         起点。collision 命名沿用离线核对过的 "<link名>_collision" 正确格式。
         fdir1 方向沿用第一轮验证过的对角线模式(RF/LR共享一条对角线、LF/RR共享另一条)，
         ignition:expressed_in="astribot_torso_base" 写法也是第一轮验证过的，直接复用。
         kp/kd 比第四轮更硬(1e6/50 vs 1e5/10)：第四轮软化是为了减少"运动学冲突残差"
         的接触抖动，现在不存在这个冲突了，需要的是真实支撑力，配置太软容易穿透。
         这组 mu/kp/kd 都是起始估算值，未经实测标定，部署前必须先跑方案第8节的
         分级测试①②③，尤其关注第一轮记录过的"小轮子在DART下数值不稳定"是否复现——
         如果复现，先走接触求解器调参清单，这也是本次"改变轮子大小做多轮测试"重点
         要验证的问题：数值不稳定的边界到底在多大的轮径。 -->
    <gazebo reference="wheel_RF_Link">
      <collision name="wheel_RF_Link_collision">
        <surface>
          <friction>
            <ode>
              <mu>0.7</mu>
              <mu2>0.0</mu2>
              <fdir1 xmlns:ignition="http://ignitionrobotics.org/schema"
                     ignition:expressed_in="astribot_torso_base">1 1 0</fdir1>
            </ode>
            <torsional>
              <coefficient>0.05</coefficient>
              <use_patch_radius>true</use_patch_radius>
              <patch_radius>0.01</patch_radius>
            </torsional>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>50.0</kd>
              <max_vel>0.05</max_vel>
              <min_depth>0.0005</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </gazebo>
    <gazebo reference="wheel_LF_Link">
      <collision name="wheel_LF_Link_collision">
        <surface>
          <friction>
            <ode>
              <mu>0.7</mu>
              <mu2>0.0</mu2>
              <fdir1 xmlns:ignition="http://ignitionrobotics.org/schema"
                     ignition:expressed_in="astribot_torso_base">1 -1 0</fdir1>
            </ode>
            <torsional>
              <coefficient>0.05</coefficient>
              <use_patch_radius>true</use_patch_radius>
              <patch_radius>0.01</patch_radius>
            </torsional>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>50.0</kd>
              <max_vel>0.05</max_vel>
              <min_depth>0.0005</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </gazebo>
    <gazebo reference="wheel_RR_Link">
      <collision name="wheel_RR_Link_collision">
        <surface>
          <friction>
            <ode>
              <mu>0.7</mu>
              <mu2>0.0</mu2>
              <fdir1 xmlns:ignition="http://ignitionrobotics.org/schema"
                     ignition:expressed_in="astribot_torso_base">1 -1 0</fdir1>
            </ode>
            <torsional>
              <coefficient>0.05</coefficient>
              <use_patch_radius>true</use_patch_radius>
              <patch_radius>0.01</patch_radius>
            </torsional>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>50.0</kd>
              <max_vel>0.05</max_vel>
              <min_depth>0.0005</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </gazebo>
    <gazebo reference="wheel_LR_Link">
      <collision name="wheel_LR_Link_collision">
        <surface>
          <friction>
            <ode>
              <mu>0.7</mu>
              <mu2>0.0</mu2>
              <fdir1 xmlns:ignition="http://ignitionrobotics.org/schema"
                     ignition:expressed_in="astribot_torso_base">1 1 0</fdir1>
            </ode>
            <torsional>
              <coefficient>0.05</coefficient>
              <use_patch_radius>true</use_patch_radius>
              <patch_radius>0.01</patch_radius>
            </torsional>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>50.0</kd>
              <max_vel>0.05</max_vel>
              <min_depth>0.0005</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </gazebo>

  </xacro:macro>

</robot>
