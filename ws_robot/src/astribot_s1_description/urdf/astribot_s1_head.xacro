<?xml version="1.0"?>
<!--
  文件用途：Astribot S1 头部（2 自由度：pan/tilt），挂载在躯干末端虚拟点 astribot_torso_end_effector 上。
  数值来源同上：astribot_whole_body_with_wheel.urdf，仅修正 mesh 路径并为缺失 collision 的 link 补碰撞体。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="astribot_head_base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.02816247 -0.00023176 -0.05211965"/>
      <mass value="0.39541440"/>
      <inertia ixx="0.00036025" ixy="-0.00003505" ixz="0.00004865" iyy="0.00049377" iyz="0.00000243" izz="0.00074441"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://astribot_s1_description/meshes/s1_head/astribot_head_base_link.STL"/>
      </geometry>
      <material name="astribot_head_color">
        <color rgba="0.807843137254902 0.843137254901961 0.905882352941176 1"/>
      </material>
    </visual>
    <!-- 原文件缺失 collision：按 STL 包围盒(0.0971x0.1077x0.0110, 中心≈(-0.032,0,-0.048)) 补扁盒碰撞 -->
    <collision>
      <origin rpy="0 0 0" xyz="-0.0322 0 -0.0478"/>
      <geometry>
        <box size="0.10 0.11 0.02"/>
      </geometry>
    </collision>
  </link>

  <link name="astribot_head_link_1">
    <inertial>
      <origin rpy="0 0 0" xyz="0.00003191 -0.00038566 -0.02579910"/>
      <mass value="0.13910581"/>
      <inertia ixx="0.00004567" ixy="0.00000003" ixz="0.00000004" iyy="0.00004789" iyz="-0.00000091" izz="0.00003779"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://astribot_s1_description/meshes/s1_head/astribot_head_link_1.STL"/>
      </geometry>
      <material name="astribot_light_color">
        <color rgba="0.898039215686275 0.917647058823529 0.929411764705882 1"/>
      </material>
    </visual>
    <!-- 原文件缺失 collision：按 STL 包围盒(0.0315x0.0312x0.0928, 中心≈(0,0,-0.031)) 补圆柱碰撞 -->
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.031"/>
      <geometry>
        <cylinder radius="0.02" length="0.09"/>
      </geometry>
    </collision>
  </link>
  <joint name="astribot_head_joint_1" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="astribot_head_base_link"/>
    <child link="astribot_head_link_1"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" lower="-1.57" upper="1.57" velocity="4.0"/>
  </joint>

  <link name="astribot_head_link_2">
    <inertial>
      <origin rpy="0 0 0" xyz="0.00705824 -0.14472601 -0.00061724"/>
      <mass value="0.97012447"/>
      <inertia ixx="0.00555660" ixy="-0.00041600" ixz="-0.00000036" iyy="0.00151908" iyz="-0.00012043" izz="0.00544493"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://astribot_s1_description/meshes/s1_head/astribot_head_link_2.STL"/>
      </geometry>
      <material name="astribot_head_color">
        <color rgba="0.807843137254902 0.843137254901961 0.905882352941176 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 -0.15 0"/>
      <geometry>
        <sphere radius="0.11"/>
      </geometry>
    </collision>
  </link>
  <joint name="astribot_head_joint_2" type="revolute">
    <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
    <parent link="astribot_head_link_1"/>
    <child link="astribot_head_link_2"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" lower="-1.22" upper="1.22" velocity="4.0"/>
  </joint>

  <joint name="astribot_head_fixed_joint" type="fixed">
    <parent link="astribot_torso_end_effector"/>
    <child link="astribot_head_base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.1229"/>
  </joint>

</robot>
