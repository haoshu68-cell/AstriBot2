<?xml version="1.0"?>
<!--
  文件用途：机器人自身携带的传感器 —— 双 Livox Mid-360 3D 激光雷达 + 头部 RGB 相机。
  用 xacro:if 通过顶层参数 use_lidar/use_camera 开关。均使用 Gazebo 官方 gz-sim 传感器插件
  （非实验性），通过 ros_gz_bridge 转出标准 ROS2 话题（見
  astribot_s1_gazebo_bringup/launch/warehouse_sim.launch.py 里的 bridge_args）。

  ============================ Livox Mid-360 仿真说明（务必先读） ============================
  实测确认：Ignition/Gz Sim 目前没有官方或主流维护的 Mid-360 真实"非重复花瓣扫描"仿真插件
  （官方 livox_laser_simulation 仓库只支持 Gazebo Classic，没有 gz-sim 移植版）。
  本方案采用社区通用做法：用 gz-sim 原生 <sensor type="gpu_lidar"> 配置成与 Mid-360 规格
  一致的视场角（水平360°、垂直 -7°~+52°共59°）来近似，输出标准 PointCloud2 点云，
  在数据链路和下游算法层面与真实 Mid-360 等价，但不是逐点还原真实花瓣扫描图案——
  这一点在 astribot_s1_perception 包的 README 里也会再次说明，避免误认为是精确仿真。
  ============================================================================================
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= Livox Mid-360 宏：左右各实例化一次 ================= -->
  <!-- 宏默认值 = 实机 front(IP .12) 的实测安装位姿。调用方（astribot_s1.xacro）
       一律显式传 xyz/rpy，所以这里的默认值只在"有人漏传"时兜底 ——
       原来兜底的是 0.28 0.18 0.10 / 0 0 0.4 那组占位值，与实机差 0.108m/68.8°，
       漏传时会静默生效，故一并改成实测值。推导与校验见 astribot_s1.xacro 的注释。 -->
  <xacro:macro name="astribot_s1_livox_mid360"
               params="side parent:=astribot_torso_base robot_name:=astribot_s1
                       xyz:='0.17393 0.16893 0.082' rpy:='0 0 -0.800058'">

    <link name="livox_mid360_${side}">
      <inertial>
        <!-- 官方规格：65x65x60mm, 265g -->
        <mass value="0.265"/>
        <inertia ixx="0.00015" ixy="0" ixz="0" iyy="0.00015" iyz="0" izz="0.00012"/>
      </inertial>
      <visual>
        <geometry>
          <cylinder radius="0.0325" length="0.06"/>
        </geometry>
        <material name="astribot_lidar_color">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.0325" length="0.06"/>
        </geometry>
      </collision>
    </link>

    <joint name="livox_mid360_${side}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="livox_mid360_${side}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- ══════════ livox_frame：实机点云真正携带的 frame_id ══════════
         厂商驱动 launch 里 `frame_id = 'livox_frame'` 是**一个全局值**，
         于是 /livox/lidar_front 与 /livox/lidar_back 两路点云的 header.frame_id
         **都是** `livox_frame`（实测，直接解 CDR 取的）。而 TF 树里从来没有
         这个 frame —— 结果是任何靠 TF 摆放点云的消费者
         （pointcloud_slice_scan_node 的自滤）在实机上
         直接查不到变换，而不是"位置略有偏差"。

         两路共用一个 frame_id 并**不是**厂商的疏漏：驱动通过
         SetLivoxLidarInstallAttitude 把外参写进雷达设备本身，
         所以 back 发出的点已经在 front 的坐标系里了（见 MID360_config.json
         与 livox_extrinsics.yaml 的说明）。也就是说
             livox_frame ≡ front 雷达坐标系 ≡ livox_mid360_left
         这条恒等边只是把"实机的命名"接到"URDF 的命名"上。

         为什么放在 URDF 而不是单独起 static_transform_publisher：
         RSP 已经在发 /tf_static，多一条边不用多一个进程，也不会出现
         "同一条边两个源"。只在 side == 左侧那次实例化时发，避免两个父。 -->
    <xacro:if value="${side == 'left'}">
      <link name="livox_frame"/>
      <joint name="livox_frame_joint" type="fixed">
        <parent link="livox_mid360_${side}"/>
        <child link="livox_frame"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>
    </xacro:if>

    <gazebo reference="livox_mid360_${side}">
      <sensor name="livox_mid360_${side}_sensor" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <!-- 绝对话题名，gz-sim 会在其后缀 "/points" 输出 gz.msgs.PointCloudPacked 点云
             （对应 ros_gz_bridge 里 .../points@sensor_msgs/msg/PointCloud2[gz.msgs.PointCloudPacked
             的桥接写法，见 warehouse_sim.launch.py）。 -->
        <topic>/model/${robot_name}/livox_mid360_${side}</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <!-- 水平 360°，采样数按 Mid-360 单帧约 20000 点(10Hz下等效200000pts/s)量级近似取，
                   实测如果卡顿可调低（见 astribot_s1_perception/README_PERCEPTION.md 里的降采样建议）。 -->
              <samples>400</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <!-- Mid-360 真实垂直视场 -7°~+52°(共59°)，换算弧度：-0.1222 ~ 0.9076 -->
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>-0.1222</min_angle>
              <max_angle>0.9076</max_angle>
            </vertical>
          </scan>
          <range>
            <!-- 官方规格：盲区0.1~0.2m，最远70m(高反射率)；仿真里取中间值，太远会引入仓储世界
                 外墙/屋顶的无效远点，拖慢下游点云处理 -->
            <min>0.10</min>
            <max>40.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>

      <!-- Voxel-SLAM consumes the same standard sensor_msgs/Imu topic in
           simulation and on hardware.  Only the left/front sensor carries
           the IMU so the two lidar streams do not create duplicate IMU
           publishers. -->
      <xacro:if value="${side == 'left'}">
        <sensor name="livox_mid360_imu" type="imu">
          <topic>/model/${robot_name}/livox_mid360_imu</topic>
          <always_on>true</always_on>
          <update_rate>200</update_rate>
          <visualize>false</visualize>
        </sensor>
      </xacro:if>
    </gazebo>
  </xacro:macro>

  <!-- Calibrated camera instance.  Names are prefixed by id so all six
       firmware cameras can coexist in one model without frame/sensor clashes. -->
  <xacro:macro name="astribot_s1_calibrated_camera" params="id parent robot_name profile native_distortion:=false mounts_file:='' sensor_enabled:=true">
    <xacro:property name="camera" value="${xacro.load_yaml(profile)}"/>
    <xacro:property name="mount" value="${xacro.load_yaml(mounts_file)['cameras'][id] if mounts_file else camera}"/>
    <xacro:property name="housing_size" value="${mount.get('housing_size', '0.03 0.08 0.03')}"/>
    <!-- camera_link is the entrance pupil. Housing belongs behind that plane,
         not around the sensor origin, otherwise it can occlude its own lens. -->
    <xacro:property name="housing_center" value="${mount.get('housing_center_xyz', '-0.016 0 0')}"/>
    <link name="${id}_camera_link">
      <inertial><origin xyz="${housing_center}"/><mass value="0.05"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
      <visual><origin xyz="${housing_center}"/><geometry><box size="${housing_size}"/></geometry><material name="astribot_camera_color"><color rgba="0.05 0.05 0.05 1"/></material></visual>
      <!-- An override may omit only volume already represented by the fixed
           parent's collision geometry; the reference profile tests this union. -->
      <collision><origin xyz="${mount.get('collision_housing_center_xyz', housing_center)}"/><geometry><box size="${mount.get('collision_housing_size', housing_size)}"/></geometry></collision>
      <xacro:if value="${'mount_bracket_size' in mount}">
        <visual name="${id}_mount_bracket">
          <origin xyz="${mount.mount_bracket_center_xyz}"/>
          <geometry><box size="${mount.mount_bracket_size}"/></geometry>
          <material name="astribot_camera_bracket_color"><color rgba="0.45 0.45 0.45 1"/></material>
        </visual>
        <xacro:if value="${mount.get('mount_bracket_collision', True)}">
          <collision name="${id}_mount_bracket_collision">
            <origin xyz="${mount.mount_bracket_center_xyz}"/>
            <geometry><box size="${mount.mount_bracket_size}"/></geometry>
          </collision>
        </xacro:if>
      </xacro:if>
    </link>
    <joint name="${id}_camera_joint" type="fixed">
      <parent link="${mount.get('parent_frame', parent)}"/><child link="${id}_camera_link"/>
      <origin xyz="${mount.mount_xyz}" rpy="${mount.mount_rpy}"/>
    </joint>
    <link name="${id}_camera_optical_frame"/>
    <joint name="${id}_camera_optical_joint" type="fixed">
      <parent link="${id}_camera_link"/><child link="${id}_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
    </joint>
    <!-- Installed housing and fixed frames remain present when capture is disabled. -->
    <xacro:if value="${sensor_enabled}">
    <gazebo reference="${id}_camera_link">
      <sensor name="${id}_sensor" type="${camera.sensor_type}">
        <pose>0 0 0 0 0 0</pose>
        <topic>${'/model/' + robot_name + '/' + id if camera.sensor_type == 'rgbd_camera' else '/model/' + robot_name + '/' + id + '/image_raw'}</topic>
        <update_rate>${camera.rate_hz}</update_rate><always_on>true</always_on><visualize>false</visualize>
        <camera>
          <horizontal_fov>${camera.horizontal_fov}</horizontal_fov>
          <image><width>${camera.width}</width><height>${camera.height}</height><format>R8G8B8</format></image>
          <clip><near>${camera.near_m}</near><far>${camera.far_m}</far></clip>
          <xacro:if value="${native_distortion}">
            <!-- YAML follows ROS/OpenCV order k1,k2,p1,p2,k3; SDF uses k1,k2,k3,p1,p2. -->
            <distortion>
              <k1>${camera.distortion[0]}</k1><k2>${camera.distortion[1]}</k2><k3>${camera.distortion[4]}</k3>
              <p1>${camera.distortion[2]}</p1><p2>${camera.distortion[3]}</p2>
              <center>${camera.intrinsics.color[2] / camera.width} ${camera.intrinsics.color[5] / camera.height}</center>
            </distortion>
          </xacro:if>
        </camera>
      </sensor>
    </gazebo>
    </xacro:if>
  </xacro:macro>

  <!-- Legacy single head camera entry point retained for downstream launch files. -->
  <xacro:macro name="astribot_s1_camera" params="parent:=astribot_head_link_2 robot_name:=astribot_s1 profile">
    <xacro:property name="camera" value="${xacro.load_yaml(profile)}"/>
    <link name="camera_link">
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.03 0.08 0.03"/>
        </geometry>
        <material name="astribot_camera_color">
          <color rgba="0.05 0.05 0.05 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.03 0.08 0.03"/>
        </geometry>
      </collision>
    </link>
    <!-- head_link_2 的+y方向即"前方"（其球面碰撞体 collision 原点在 y=-0.15，
         说明 mesh 正面朝 -y？此处按已知 head 前视方向挂载，出生后可在 RViz 里核对朝向再微调） -->
    <joint name="camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="camera_link"/>
      <origin xyz="${camera.mount_xyz}" rpy="${camera.mount_rpy}"/>
    </joint>
    <link name="camera_optical_frame"/>
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/><child link="camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
    </joint>

    <gazebo reference="camera_link">
      <sensor name="astribot_camera" type="${camera.sensor_type}">
        <pose>0 0 0 0 0 0</pose>
        <topic>${'/model/' + robot_name + '/camera' if camera.sensor_type == 'rgbd_camera' else '/model/' + robot_name + '/camera/image_raw'}</topic>
        <update_rate>${camera.rate_hz}</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>${camera.horizontal_fov}</horizontal_fov>
          <image>
            <width>${camera.width}</width>
            <height>${camera.height}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>${camera.near_m}</near>
            <far>${camera.far_m}</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
