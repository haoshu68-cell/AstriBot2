<?xml version="1.0"?>
<!--
  文件用途：机器人自身携带的传感器 —— 双 Livox Mid-360 3D 激光雷达 + 头部 RGB 相机。
  用 xacro:if 通过顶层参数 use_lidar/use_camera 开关。均使用 Gazebo 官方 gz-sim 传感器插件
  （非实验性），通过 ros_gz_bridge 转出标准 ROS2 话题（見
  astribot_s1_gazebo_bringup/launch/warehouse_sim.launch.py 里的 bridge_args）。

  ============================ Livox Mid-360 仿真说明（务必先读） ============================
  实测确认：Ignition/Gz Sim 目前没有官方或主流维护的 Mid-360 真实"非重复花瓣扫描"仿真插件
  （官方 livox_laser_simulation 仓库只支持 Gazebo Classic，没有 gz-sim 移植版）。
  本方案采用社区通用做法：用 gz-sim 原生 <sensor type="gpu_lidar"> 配置成与 Mid-360 规格
  一致的视场角（水平360°、垂直 -7°~+52°共59°）来近似，输出标准 PointCloud2 点云，
  在数据链路和下游算法层面与真实 Mid-360 等价，但不是逐点还原真实花瓣扫描图案——
  这一点在 astribot_s1_perception 包的 README 里也会再次说明，避免误认为是精确仿真。
  ============================================================================================
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= Livox Mid-360 宏：左右各实例化一次 ================= -->
  <xacro:macro name="astribot_s1_livox_mid360"
               params="side parent:=astribot_torso_base robot_name:=astribot_s1
                       xyz:='0.28 0.18 0.10' rpy:='0 0 0.4'">

    <link name="livox_mid360_${side}">
      <inertial>
        <!-- 官方规格：65x65x60mm, 265g -->
        <mass value="0.265"/>
        <inertia ixx="0.00015" ixy="0" ixz="0" iyy="0.00015" iyz="0" izz="0.00012"/>
      </inertial>
      <visual>
        <geometry>
          <cylinder radius="0.0325" length="0.06"/>
        </geometry>
        <material name="astribot_lidar_color">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.0325" length="0.06"/>
        </geometry>
      </collision>
    </link>

    <joint name="livox_mid360_${side}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="livox_mid360_${side}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <gazebo reference="livox_mid360_${side}">
      <sensor name="livox_mid360_${side}_sensor" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <!-- 绝对话题名，gz-sim 会在其后缀 "/points" 输出 gz.msgs.PointCloudPacked 点云
             （对应 ros_gz_bridge 里 .../points@sensor_msgs/msg/PointCloud2[gz.msgs.PointCloudPacked
             的桥接写法，见 warehouse_sim.launch.py）。 -->
        <topic>/model/${robot_name}/livox_mid360_${side}</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <!-- 水平 360°，采样数按 Mid-360 单帧约 20000 点(10Hz下等效200000pts/s)量级近似取，
                   实测如果卡顿可调低（见 astribot_s1_perception/README_PERCEPTION.md 里的降采样建议）。 -->
              <samples>400</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <!-- Mid-360 真实垂直视场 -7°~+52°(共59°)，换算弧度：-0.1222 ~ 0.9076 -->
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>-0.1222</min_angle>
              <max_angle>0.9076</max_angle>
            </vertical>
          </scan>
          <range>
            <!-- 官方规格：盲区0.1~0.2m，最远70m(高反射率)；仿真里取中间值，太远会引入仓储世界
                 外墙/屋顶的无效远点，拖慢下游点云处理 -->
            <min>0.10</min>
            <max>40.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="astribot_s1_camera" params="parent:=astribot_head_link_2 robot_name:=astribot_s1">
    <link name="camera_link">
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.03 0.08 0.03"/>
        </geometry>
        <material name="astribot_camera_color">
          <color rgba="0.05 0.05 0.05 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.03 0.08 0.03"/>
        </geometry>
      </collision>
    </link>
    <!-- head_link_2 的+y方向即"前方"（其球面碰撞体 collision 原点在 y=-0.15，
         说明 mesh 正面朝 -y？此处按已知 head 前视方向挂载，出生后可在 RViz 里核对朝向再微调） -->
    <joint name="camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="camera_link"/>
      <origin xyz="0 -0.22 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <gazebo reference="camera_link">
      <sensor name="astribot_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <topic>/model/${robot_name}/camera/image_raw</topic>
        <update_rate>30</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
