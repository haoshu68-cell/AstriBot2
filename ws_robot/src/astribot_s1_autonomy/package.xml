<?xml version="1.0"?>
<package format="3">
  <name>astribot_s1_autonomy</name>
  <version>0.2.0</version>
  <description>Compatibility launch facade for perception and exploration; no algorithms or command publishers.</description>
  <maintainer email="dev@astribot.local">Astribot Robotics</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>astribot_autonomy_core</depend>
  <depend>astribot_s1_perception_components</depend>
  <depend>astribot_s1_exploration</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>astribot_logging</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
