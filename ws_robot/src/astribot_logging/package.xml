<?xml version="1.0"?>
<package format="3">
  <name>astribot_logging</name>
  <version>0.1.0</version>
  <description>Shared spdlog logging for Astribot SDK, tools and ROS launch.</description>
  <maintainer email="dev@astribot.local">Astribot Robotics</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>spdlog</depend>
  <exec_depend>rcl_logging_spdlog</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
