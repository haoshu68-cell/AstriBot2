<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="WalkRoute">
  <BehaviorTree ID="WalkRoute">
    <Fallback>
      <Sequence>
        <IsGoalReached agent_id="{id}"/>
        <UpdateGoal agent_id="{id}"/>
      </Sequence>
      <RegularNav agent_id="{id}" time_step="{dt}"/>
    </Fallback>
  </BehaviorTree>
</root>
