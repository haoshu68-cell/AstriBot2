<?xml version="1.0" encoding="UTF-8" ?>
<!-- Local simulation bridge only. A 640x360 depth frame (921600 B) exceeds
     Fast DDS 2.6's default 512 KiB SHM segment. Keep complete frames in bounded
     shared memory; UDP discovery is restricted to loopback. No kernel tuning.
     ROS_LOCALHOST_ONLY=0 avoids Humble appending a second default SHM transport. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>astribot_camera_shm</transport_id>
      <type>SHM</type>
      <segment_size>16777216</segment_size>
      <maxMessageSize>4194304</maxMessageSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>astribot_sim_loopback</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="astribot_camera_bridge" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>astribot_camera_shm</transport_id>
        <transport_id>astribot_sim_loopback</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
