<?xml version="1.0"?>
<package format="3">
  <name>astribot_s1_manipulation_perception</name>
  <version>0.1.0</version>
  <description>Bounded C++ actions for GraspNet proposals and known-model object pose.</description>
  <maintainer email="astribot-dev@astribot.com">astribot-dev</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend><depend>rclcpp_action</depend>
  <depend>astribot_perception_msgs</depend>
  <depend>astribot_transport_msgs</depend>
  <depend>astribot_s1_manipulation</depend>
  <depend>control_msgs</depend><depend>ompl</depend><depend>moveit_planners_ompl</depend>
  <depend>sensor_msgs</depend><depend>geometry_msgs</depend>
  <depend>tf2</depend><depend>nlohmann_json</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend><depend>libopencv-dev</depend>
